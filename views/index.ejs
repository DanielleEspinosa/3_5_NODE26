<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to EJS</title>
</head>

<body>
    <form action="/register" method="POST">
        <input type="text" name="fn" placeholder="Enter your Firstname" required>
        <br>
        <input type="text" name="ln" placeholder="Enter your Lastname" required>
        <br>
        <input type="number" name="age" placeholder="Enter your Age" required>
        <br>
        <input type="text" name="add" placeholder="Enter your Address" required>
        <br>
        <button type="submit">Register</button>
    </form>
</body>

</html>